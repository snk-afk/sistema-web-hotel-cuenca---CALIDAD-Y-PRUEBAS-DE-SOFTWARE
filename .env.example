# App Environment Settings
APP_NAME="CS-Hotel"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Lima
APP_KEY=secret_app_key_32_characters_long_str
HEALTH_TOKEN=

# Database Connection (MySQL Strict Mode)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DRIVER=mysql
DB_DATABASE=railway
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Production bootstrap account (required only for --env=production)
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=

# Reverse proxy trust (only enable with an explicit proxy allowlist)
TRUSTED_PROXY_ENABLED=false
TRUSTED_PROXIES=

# Database Connection for Testing
DB_TEST_DATABASE=railway_test

# Realtime / Pusher WebSockets Settings
PUSHER_ENABLED=false
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
PUSHER_HOST=127.0.0.1
PUSHER_PORT=6001
PUSHER_SCHEME=http

# Storage Driver Settings (local vs r2)
STORAGE_DRIVER=local
STORAGE_TIMEOUT_SECONDS=15
STORAGE_ROOT=
STORAGE_LOCAL_PATH=
STORAGE_COMPROBANTES_PATH=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Runtime logs (optional absolute path outside the release directory)
LOG_PATH=

# SUNAT Billing Settings (simulated vs real)
SUNAT_MODE=simulated
SUNAT_ENDPOINT=
SUNAT_TIMEOUT_SECONDS=15
SUNAT_RUC=
SUNAT_SOL_USER=
SUNAT_SOL_PASS=
SUNAT_CERT_PATH=
SUNAT_CERT_PASS=

# JSONPE DNI/RUC Lookup API
JSONPE_ENABLED=false
JSONPE_API_TOKEN=
JSONPE_BASE_URL=https://api.jsonpe.com
