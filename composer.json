{
    "name": "cs-hotel/app",
    "description": "CS-Hotel — Pure PHP 8.4 spec-driven hotel management system",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "endroid/qr-code": "^6.1",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^1.11",
        "phpstan/phpstan-strict-rules": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "Database\\Seeds\\": "database/seeds/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
